{
    "version": 3,
    "configurePresets": [
        {
            "name": "gd32f303",
            "displayName": "YH_JM GD32F303",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "YFOC_BOARD": "YH_JM",
                "CAN_PROTOCOL": "v1",
                "YFOC_FACTORY_TEST": "OFF"
            }
        },
        {
            "name": "gd32f303-dm4310",
            "displayName": "YH_JM DM4310 MIT (bench)",
            "inherits": "gd32f303",
            "cacheVariables": {
                "CAN_PROTOCOL": "dm4310"
            }
        },
        {
            "name": "gd32f303-debug",
            "displayName": "YH_JM GD32F303 (Debug)",
            "inherits": "gd32f303",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gd32f303-factory",
            "displayName": "YH_JM factory test",
            "inherits": "gd32f303",
            "cacheVariables": {
                "YFOC_FACTORY_TEST": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gd32f303",
            "configurePreset": "gd32f303"
        },
        {
            "name": "gd32f303-dm4310",
            "configurePreset": "gd32f303-dm4310"
        },
        {
            "name": "gd32f303-debug",
            "configurePreset": "gd32f303-debug"
        },
        {
            "name": "gd32f303-factory",
            "configurePreset": "gd32f303-factory"
        }
    ]
