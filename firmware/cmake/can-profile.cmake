function(jm1_add_profile target model)
    set(dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../App/compat")
    if(model STREQUAL "rs05" OR model STREQUAL "cybergear")
        set(codec stride)
    elseif(model STREQUAL "ak60-6")
        set(codec ak)
    elseif(model STREQUAL "rmd-x" OR model STREQUAL "lk-mf")
        set(codec rmd)
    elseif(model STREQUAL "hightorque")
        set(codec hightorque)
    elseif(model STREQUAL "c620" OR model STREQUAL "c610")
        set(codec dji)
    else()
        message(FATAL_ERROR "Unknown JM1 profile ${model}")
    endif()
    string(MAKE_C_IDENTIFIER "${model}" flag)
    string(TOUPPER "${flag}" flag)
    target_compile_definitions(${target} PRIVATE CFG_CAN_COMPAT=1 CFG_${flag}=1 JM1_PROFILE_NAME="${model}")
    target_sources(${target} PRIVATE "${dir}/comm_profile.c" "${dir}/${codec}.c")
endfunction()
